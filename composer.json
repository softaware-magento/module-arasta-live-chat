{
    "name": "softaware/module-arasta-live-chat",
    "description": "Connects Magento 2 to Arasta live chat and support: widget loader on Luma and Hyvä, signed customer identity, invoice PDF and version REST endpoints, and order-to-conversation linking.",
    "type": "magento2-module",
    "license": "proprietary",
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "~103.0.7",
        "softaware/module-core": "^1.0",
        "magento/module-authorization": "*",
        "magento/module-backend": "*",
        "magento/module-checkout": "*",
        "magento/module-config": "*",
        "magento/module-csp": "*",
        "magento/module-customer": "*",
        "magento/module-integration": "*",
        "magento/module-quote": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "conflict": {
        "platform/module-connector": "*"
    },
    "suggest": {
        "hyva-themes/magento2-default-theme": "Hyvä storefront support (templates included)"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Softaware\\ArastaLiveChat\\": ""
        }
    }
}
