<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Copy the conversation id from the quote to the order (QuoteManagement drops custom columns). -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="softaware_arasta_live_chat_copy_conversation" instance="Softaware\ArastaLiveChat\Observer\CopyConversationToOrder"/>
    </event>
    <!-- Post the placed order to Arasta when its quote carried a conversation id. -->
    <event name="sales_order_place_after">
        <observer name="softaware_arasta_live_chat_order_link" instance="Softaware\ArastaLiveChat\Observer\OrderPlaced"/>
    </event>
</config>
