<?xml version="1.0"?>
<!--
  Content Security Policy: the default Arasta widget host. A different loader host set in the admin is allowed by
  Softaware\ArastaLiveChat\Model\Csp\LoaderPolicyCollector (storefront only).
-->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="arasta-app" type="host">https://app.arasta.io</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="arasta-app" type="host">https://app.arasta.io</value>
                <value id="arasta-app-wss" type="host">wss://app.arasta.io</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="arasta-app" type="host">https://app.arasta.io</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="arasta-app" type="host">https://app.arasta.io</value>
            </values>
        </policy>
        <policy id="font-src">
            <values>
                <value id="arasta-app" type="host">https://app.arasta.io</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="arasta-app" type="host">https://app.arasta.io</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
