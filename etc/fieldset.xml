<?xml version="1.0"?>
<!-- The conversation id is copied to the order when the quote converts (see also Observer\CopyConversationToOrder). -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:DataObject/etc/fieldset.xsd">
    <scope id="global">
        <fieldset id="sales_convert_quote">
            <field name="platform_conversation_id">
                <aspect name="to_order"/>
            </field>
        </fieldset>
    </scope>
</config>
